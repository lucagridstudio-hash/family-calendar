{
  "name": "family-calendar",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "sh ./scripts/dev.sh",
    "dev:frontend": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "backend": "cd backend && python3 -m uvicorn app.main:app --host 0.0.0.0 --port 8000 --reload",
    "backend:start": "cd backend && python3 -m uvicorn app.main:app --host 0.0.0.0 --port 8000",
    "backend:install": "pip install -r backend/requirements.txt",
    "backend:test": "cd backend && python3 -m pytest tests/ -q",
    "seed": "cd backend && python3 -m app.seed_data",
    "db:audit": "cd backend && python3 -m scripts.audit_sqlite",
    "db:migrate:dry-run": "cd backend && python3 -m scripts.migrate_sqlite_to_postgres --dry-run",
    "db:migrate:run": "cd backend && python3 -m scripts.migrate_sqlite_to_postgres --yes",
    "db:backup": "cd backend && python3 -m scripts.backup_postgres"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2"
  }
}
